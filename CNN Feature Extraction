class TransferCNNFeatureExtractor:
    def __init__(self, cnn_params=None):
        self.cnn_params = cnn_params if cnn_params else {
            'filters1': 16, 'kernel_size1': 2,
            'filters2': 32, 'kernel_size2': 2,
            'dense_units': 16, 'dropout': 0.3
        }
        self.model = None
        self.input_shape = None

    def build_base_extractor(self, input_shape):
        self.input_shape = input_shape
        return Sequential([
            Conv1D(
                filters=self.cnn_params['filters1'],
                kernel_size=self.cnn_params['kernel_size1'],
                padding='same',
                activation='relu',
                input_shape=input_shape,
                name='conv1'
            ),
            BatchNormalization(name='bn1'),
            Dropout(self.cnn_params['dropout'], name='drop1'),
            Conv1D(
                filters=self.cnn_params['filters2'],
                kernel_size=self.cnn_params['kernel_size2'],
                padding='same',
                activation='relu',
                name='conv2'
            ),
            BatchNormalization(name='bn2'),
            Dropout(self.cnn_params['dropout'], name='drop2'),
            GlobalAveragePooling1D(name='gap'),  
            Dense(self.cnn_params['dense_units'], activation='relu', name='dense1')
        ])
    def pretrain(self, X_dynamic, y, epochs=100, batch_size=32):
        X_reshaped = X_dynamic.reshape(X_dynamic.shape[0], X_dynamic.shape[1], 1)
        self.model = self.build_base_extractor(input_shape=X_reshaped.shape[1:])

        self.model.compile(
            optimizer=Adam(learning_rate=0.001),
            loss='mse'
        )
        callbacks = [
            ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=5, min_lr=1e-6),
            EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True)
        ]
        self.model.fit(
            X_reshaped, y,
            epochs=epochs,
            batch_size=batch_size,
            validation_split=0.2,
            callbacks=callbacks,
            verbose=1
        )
        return self.model

    def train_shared_extractor(self, X_dynamic, y, epochs=100, batch_size=32):
        X_reshaped = X_dynamic.reshape(X_dynamic.shape[0], X_dynamic.shape[1], 1)
        # 构建基础模型
        self.model = self.build_base_extractor(input_shape=X_reshaped.shape[1:])
        for layer in self.model.layers[:-1]: 
            layer.trainable = False
        self.model.compile(
            optimizer=Adam(learning_rate=1e-3), 
            loss='mse'
        )
        self.model.fit(
            X_reshaped, y,
            epochs=epochs,
            batch_size=batch_size,
            validation_split=0.2,
            callbacks=[early_stop],
            verbose=1
        )
        return self.model

    def extract_features(self, X_dynamic):
        """提取特征"""
        X_reshaped = X_dynamic.reshape(X_dynamic.shape[0], X_dynamic.shape[1], 1)
        return self.model.predict(X_reshaped, verbose=0)
