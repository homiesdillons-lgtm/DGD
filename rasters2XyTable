def rasters2XyTable():
    predicates = glob.glob(os.path.join(predicateF, '*.tif')) 
    coarseDynamicPredictors = [] 
    features = []
    for predicate in predicates:
        coarseStaticPredictors = glob.glob(os.path.join(coarseStaticPredictorsF, '*.tif'))
        ID = os.path.split(predicate)[1].split('.')[0].split('_')[1]
        coarseDynamicPredictors = glob.glob(
            os.path.join(coarseDynamicPredictorsF, '*_{}.tif'.format(ID)))  
        variables = coarseStaticPredictors + coarseDynamicPredictors + [predicate]
        variables.sort()
        XyTable = os.path.join(Xy, 'XyTable_{}.csv'.format(ID))
        if len(variables) > 0:
            data = {}
            for variable in variables:
                name = os.path.split(variable)[1].split('.')[0].split('_')[0]
                inDs = gdal.Open(variable, gdal.GA_ReadOnly)
                inBand = inDs.GetRasterBand(1)
                gdtype, nptype, fNDV, tNDV = dtypes(inBand)  
                inArray = inBand.ReadAsArray().astype(nptype).flatten() 
                if fNDV:
                    inArray = np.where(inArray == fNDV, np.nan, inArray)  
                data[name] = inArray 

            dfXy = pd.DataFrame.from_dict(data) 
            dfXy = dfXy.dropna()  
            cols = list(dfXy.columns)  
            for col in cols:
                if col not in features:
                    features.append(col)  
            if 'Mas' in cols:
                cols.remove('Mas') 

            dfXy = dfXy[cols]
            print('Creating {} variables of {}: XyTable_{}'.format(len(cols), len(variables), ID))
            dfXy.to_csv(XyTable, index=False)  # 将DataFrame写入CSV文件
    features.sort() 
    print('\nFeatures')
    return features
