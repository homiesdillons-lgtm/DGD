def haversine_distance_vectorized(coords1, coords2):
    R = 6371000  
    coords1_rad = np.radians(coords1) 
    coords2_rad = np.radians(coords2) 
    lat1, lon1 = coords1_rad[:, 0], coords1_rad[:, 1]
    lat2, lon2 = coords2_rad[:, 0], coords2_rad[:, 1]
    dlat = lat2[np.newaxis, :] - lat1[:, np.newaxis]  
    dlon = lon2[np.newaxis, :] - lon1[:, np.newaxis]

    a = np.sin(dlat / 2) ** 2 + np.cos(lat1[:, np.newaxis]) * np.cos(lat2[np.newaxis, :]) * np.sin(dlon / 2) ** 2
    c = 2 * np.arcsin(np.sqrt(a))
    return R * c  

def distance_matrix(coords1, coords2):
    print(f"计算距离矩阵: {len(coords1)} × {len(coords2)} 点对")
    return haversine_distance_vectorized(coords1, coords2)

